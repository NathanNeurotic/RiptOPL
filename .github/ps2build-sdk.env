# The exact ps2build SDK every RiptOPL build uses. tools/ps2build_sdk.sh installs it (cache, then the
# checksummed NathanNeurotic/ps2build-mirror release, then the official server pinned per component), and
# tools/install_ps2build.sh adds the pinned ogg/vorbis packages. CI caches the SDK under a hash of this file.
#
# To move to a newer SDK, replace this file with the pin.env of a ps2build-mirror release, in a PR.
# PS2BUILD_SDK_TAG and PS2BUILD_SDK_SUMS_SHA256 stay empty until the mirror has published this suite;
# until then the official server is used, still pinned to these versions.
PS2BUILD_SDK_MIRROR=NathanNeurotic/ps2build-mirror
PS2BUILD_SDK_TAG=sdk-v2026.10.15-4a98265d
PS2BUILD_SDK_SUMS_SHA256=c7e1727b020374179088f8a74c9a195502639194c29a637799b3b09f019727e0
PS2BUILD_COMPONENTS="cmake=v2026.10.12 ninja=v1.13.2 ps2build=v2026.10.15 sdk-core=v2026.10.13.1 sdk-world=v2026.10.13.1 toolchain=v2026.09.27 tools=v2026.09.29.1 vcl=v2026.10.07"
PS2BUILD_LLVM_TOOLCHAIN=v0.3.8
OGG_VERSION=v2026.10.13
VORBIS_VERSION=v2026.10.13
